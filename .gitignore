# =====================================================================
# Publication policy: this repository publishes the demo and every
# experiment script behind a number in the paper. What stays local is the
# raw results, the research write-ups (notes/, revision_notes/), and
# exp04, whose verbal-report study the paper does not draw on.
#
# Whitelist approach: ignore everything, then re-include the published
# files explicitly. New files therefore default to NOT published; add
# an explicit "!" entry below when something should be released.
# =====================================================================

*

# ---- repository / environment ----
!.gitignore
!.python-version
!LICENSE
!README.md
!pyproject.toml
!uv.lock

# ---- the demo (self-contained: run.py imports only core and steering) ----
!exp05-integrated-demo/
exp05-integrated-demo/*
!exp05-integrated-demo/core.py
!exp05-integrated-demo/run.py
!exp05-integrated-demo/steering.py

# ---- objective families vs fixed weights ----
!exp01-objective-steering/
exp01-objective-steering/*
!exp01-objective-steering/README.md
!exp01-objective-steering/core.py
!exp01-objective-steering/run.py
!exp01-objective-steering/verify_system1.py

# ---- how far prompting gets when the LLM must regulate ----
!exp02-system2-memory/
exp02-system2-memory/*
!exp02-system2-memory/README.md
!exp02-system2-memory/core.py
!exp02-system2-memory/run_batch.py
!exp02-system2-memory/run_c_ablation.py
!exp02-system2-memory/run_prompt_ablation.py
!exp02-system2-memory/steering.py

# ---- declaring the constraint instead: the augmented Lagrangian ----
!exp03-auglag/
exp03-auglag/*
!exp03-auglag/README.md
!exp03-auglag/core.py
!exp03-auglag/run_batch.py
!exp03-auglag/run_infeasible.py
!exp03-auglag/steering.py
!exp03-auglag/verify_auglag.py

# ---- the benchmark suite, including the system prompt in steering.py ----
# Results stay local; the scenarios and the harness that produces them do not.
!bench/
bench/*
!bench/README.md
!bench/core.py
!bench/runner.py
!bench/scenarios.py
!bench/steering.py

# ---- the frozen keyword baseline and the 21 paraphrases ----
!exp08-baseline/
exp08-baseline/*
!exp08-baseline/README.md
!exp08-baseline/core.py
!exp08-baseline/keyword_baseline.py
!exp08-baseline/policies.py
!exp08-baseline/run_comparison.py

# ---- arbitration: does the LLM act on a certified infeasibility? ----
!exp06-arbitration/
exp06-arbitration/*
!exp06-arbitration/README.md
!exp06-arbitration/common.py
!exp06-arbitration/core.py
!exp06-arbitration/plot_escalation.py
!exp06-arbitration/plot_stiffness.py
!exp06-arbitration/run_arbitration.py
!exp06-arbitration/run_probe.py
!exp06-arbitration/steering.py
!exp06-arbitration/verify_stiffness.py

# ---- the independent check on the optimality indicator ----
!exp07-certificate/
exp07-certificate/*
!exp07-certificate/README.md
!exp07-certificate/baseline_anchor.py
!exp07-certificate/core.py
!exp07-certificate/reference.py
!exp07-certificate/verify_certificate.py
!exp07-certificate/verify_certificate_seeds.py
!exp07-certificate/waterfilling.py

# ---- the channel-count sweep ----
!exp09-scale/
exp09-scale/*
!exp09-scale/README.md
!exp09-scale/core.py
!exp09-scale/reference.py
!exp09-scale/run_scale.py
!exp09-scale/run_scale_llm.py
!exp09-scale/scale_profile.py
!exp09-scale/steering.py

# ---- the scripts above write here; the results themselves stay local ----
# git will not look inside an ignored directory, so the directory has to be
# re-included before the placeholder inside it can be
!exp01-objective-steering/results/
exp01-objective-steering/results/*
!exp01-objective-steering/results/.gitkeep
!exp02-system2-memory/results/
exp02-system2-memory/results/*
!exp02-system2-memory/results/.gitkeep
!exp03-auglag/results/
exp03-auglag/results/*
!exp03-auglag/results/.gitkeep
!exp06-arbitration/results/
exp06-arbitration/results/*
!exp06-arbitration/results/.gitkeep
!exp07-certificate/results/
exp07-certificate/results/*
!exp07-certificate/results/.gitkeep
!exp09-scale/results/
exp09-scale/results/*
!exp09-scale/results/.gitkeep
